# ─────────────────────────────────────────────────────────────
# CST Café FRONTEND – environment variables
# Copy this file to .env.local. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Where the backend API runs (no trailing slash).
# Local: http://localhost:4000      Deployed: e.g. https://cst-cafe-api.onrender.com
BACKEND_URL=http://localhost:4000

# Public address of THIS website (no trailing slash). Used inside the QR codes.
# Local: http://localhost:3000      Deployed: e.g. https://cst-cafe.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
