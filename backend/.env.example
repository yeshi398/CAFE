# ─────────────────────────────────────────────────────────────
# CST Café BACKEND – environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Port the API listens on (Render/Railway set this automatically).
PORT=4000

# MongoDB connection string – include the database name /cst-cafe
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cst-cafe?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/cst-cafe
MONGODB_URI=mongodb://127.0.0.1:27017/cst-cafe

# Secret for signing admin login sessions – at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Address of the website (frontend), no trailing slash. Admin changes are only accepted
# from here. Several allowed: separate with commas.
FRONTEND_URL=http://localhost:3000

# First admin account – created by `npm run seed` (only if no admin exists yet).
ADMIN_NAME=Café Owner
ADMIN_EMAIL=owner@cstcafe.bt
ADMIN_PASSWORD=ChangeMe@2026
